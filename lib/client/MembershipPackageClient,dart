import 'dart:convert';
import 'package:http/http.dart' as http;

import '../models/membership_package.dart';

class MembershipApi {
  static const String baseUrl = "https://example.com/api/memberships";

  // Get All Membership Packages
  static Future<List<MembershipPackage>> fetchMemberships() async {
    final response = await http.get(Uri.parse(baseUrl));

    if (response.statusCode == 200) {
      final List<dynamic> data = json.decode(response.body);
      return data.map((json) => MembershipPackage.fromJson(json)).toList();
    } else {
      throw Exception("Failed to load memberships");
    }
  }

  // Get Membership Package by ID
  static Future<MembershipPackage> fetchMembershipById(int id) async {
    final response = await http.get(Uri.parse('$baseUrl/$id'));

    if (response.statusCode == 200) {
      return MembershipPackage.fromJson(json.decode(response.body));
    } else {
      throw Exception("Failed to load membership");
    }
  }

  // Create Membership Package
  static Future<MembershipPackage> createMembership(MembershipPackage package) async {
    final response = await http.post(
      Uri.parse(baseUrl),
      headers: {"Content-Type": "application/json"},
      body: json.encode(package.toJson()),
    );

    if (response.statusCode == 201) {
      return MembershipPackage.fromJson(json.decode(response.body));
    } else {
      throw Exception("Failed to create membership");
    }
  }

  // Update Membership Package
  static Future<MembershipPackage> updateMembership(
      int id, MembershipPackage package) async {
    final response = await http.put(
      Uri.parse('$baseUrl/$id'),
      headers: {"Content-Type": "application/json"},
      body: json.encode(package.toJson()),
    );

    if (response.statusCode == 200) {
      return MembershipPackage.fromJson(json.decode(response.body));
    } else {
      throw Exception("Failed to update membership");
    }
  }

  // Delete Membership Package
  static Future<void> deleteMembership(int id) async {
    final response = await http.delete(Uri.parse('$baseUrl/$id'));

    if (response.statusCode != 204) {
      throw Exception("Failed to delete membership");
    }
  }
}
